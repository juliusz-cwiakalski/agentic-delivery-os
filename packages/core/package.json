{
  "name": "@delivery-os/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./branding": {
      "types": "./dist/branding/index.d.ts",
      "default": "./dist/branding/index.js"
    }
  },
  "imports": {
    "#contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "#domain/*": "./src/domain/*.ts",
    "#app/*": "./src/app/*.ts",
    "#config/*": "./src/config/*.ts",
    "#branding/*": "./src/branding/*.ts",
    "#state/*": "./src/state/*.ts"
  },
  "workspaceImports": {},
  "dependencies": {
    "ajv": "8.20.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check:boundaries": "depcruise --config ../../.dependency-cruiser.cjs src",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:boundaries",
    "build": "tsc -p tsconfig.json && bun run ../../scripts/checks/exports-parity.ts --generate-config-artifacts"
  }
}
