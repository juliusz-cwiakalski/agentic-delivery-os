{
  "name": "@delivery-os/opencode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#commands/*": "./src/commands/*.ts",
    "#output/*": "./src/output/*.ts"
  },
  "workspaceImports": {
    "@delivery-os/core": [
      ".",
      "./contracts",
      "./state",
      "./branding"
    ],
    "@delivery-os/adapters": [
      "./gitlab",
      "./jira",
      "./github",
      "./azure",
      "./ci",
      "./registry",
      "./repo",
      "./file",
      "./host",
      "./session",
      "./legacy"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@delivery-os/core": "workspace:*",
    "@delivery-os/adapters": "workspace:*"
  }
}
