{
  "name": "@delivery-os/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/entrypoint.js",
  "bin": {
    "delivery-os": "./bin/delivery-os.ts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon-main.d.ts",
      "default": "./dist/daemon-main.js"
    }
  },
  "imports": {
    "#commands/*": "./src/commands/*.ts",
    "#output/*": "./src/output/*.ts"
  },
  "workspaceImports": {
    "@delivery-os/core": [
      ".",
      "./contracts",
      "./state",
      "./branding",
      "./provider"
    ],
    "@delivery-os/adapters": [
      "./azure",
      "./ci",
      "./credentials",
      "./daemon",
      "./file",
      "./git",
      "./github",
      "./gitlab",
      "./harness",
      "./host",
      "./jira",
      "./legacy",
      "./provider-quota",
      "./registry",
      "./repo",
      "./session"
    ]
  },
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check:boundaries": "depcruise --config ../../.dependency-cruiser.cjs src",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:boundaries",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@delivery-os/core": "workspace:*",
    "@delivery-os/adapters": "workspace:*"
  }
}
