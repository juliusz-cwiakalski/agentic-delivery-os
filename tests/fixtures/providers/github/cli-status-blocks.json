{
  "provenance": "hand-authored-synthetic 2026-11-17",
  "cases": [
    {
      "name": "200-json",
      "stdout": "HTTP/2.0 200 OK\ncontent-type: application/json\n\n{\"number\":601,\"state\":\"open\"}\n",
      "expected": { "status": 200, "body": { "number": 601, "state": "open" } }
    },
    {
      "name": "201-json",
      "stdout": "HTTP/2.0 201 Created\ncontent-type: application/json\n\n{\"id\":9001}\n",
      "expected": { "status": 201, "body": { "id": 9001 } }
    },
    {
      "name": "204-empty",
      "stdout": "HTTP/2.0 204 No Content\n\n",
      "expected": { "status": 204, "body": null }
    },
    {
      "name": "404",
      "stdout": "HTTP/2.0 404 Not Found\ncontent-type: application/json\n\n{\"message\":\"Not Found\"}\n",
      "expected": { "status": 404, "body": { "message": "Not Found" } }
    },
    {
      "name": "403",
      "stdout": "HTTP/2.0 403 Forbidden\ncontent-type: application/json\n\n{\"message\":\"Forbidden\"}\n",
      "expected": { "status": 403, "body": { "message": "Forbidden" } }
    },
    {
      "name": "500",
      "stdout": "HTTP/2.0 500 Internal Server Error\ncontent-type: application/json\n\n{\"message\":\"Server Error\"}\n",
      "expected": { "status": 500, "body": { "message": "Server Error" } }
    },
    {
      "name": "two-status-blocks",
      "stdout": "HTTP/1.1 200 Connection established\n\nHTTP/2.0 200 OK\ncontent-type: application/json\n\n{\"number\":601}\n",
      "expected": { "status": 200, "body": { "number": 601 } }
    },
    {
      "name": "two-conflicting-final-blocks",
      "stdout": "HTTP/2.0 404 Not Found\ncontent-type: application/json\n\n{\"message\":\"first\"}\nHTTP/2.0 200 OK\ncontent-type: application/json\n\n{\"number\":601}\n",
      "expected": { "status": 200, "body": { "number": 601 } }
    },
    {
      "name": "unparsable-status",
      "stdout": "HTTP/2.0 OK\ncontent-type: application/json\n\n{}\n",
      "expected": { "unparsable": true }
    },
    {
      "name": "body-without-status",
      "stdout": "content-type: application/json\n\n{\"number\":601}\n",
      "expected": { "unparsable": true }
    },
    {
      "name": "status-without-body",
      "stdout": "HTTP/2.0 200 OK\ncontent-type: application/json\n\n",
      "expected": { "status": 200, "body": null }
    },
    {
      "name": "non-json-body",
      "stdout": "HTTP/2.0 200 OK\ncontent-type: text/plain\n\nnot-json\n",
      "expected": { "unparsable": true }
    }
  ]
}
